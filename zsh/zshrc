# git
autoload -Uz vcs_info
setopt prompt_subst
zstyle ':vcs_info:git:*' check-for-changes true
zstyle ':vcs_info:git:*' stagedstr "%F{magenta}!"
zstyle ':vcs_info:git:*' unstagedstr "%F{yellow}+"
zstyle ':vcs_info:*' formats "%F{cyan}%c%u[%b]%f"
zstyle ':vcs_info:*' actionformats '[%b|%a]'
precmd () { vcs_info }

# prompt
PROMPT='
[%B%F{red}%n@%f%b:%F{green}%~%f]%F{cyan}$vcs_info_msg_0_%f
%F{yellow}>%f '

# alias
alias procon-support='source ~/repos/atcoder-rust/support.sh'
alias reload='source ~/.zshrc'
alias ll='ls -la'
alias memo='code ~/repos/personal'
alias blog='code ~/repos/profile'
alias zenn='code ~/repos/okaponta-zenn'
alias cc='claude --dangerously-skip-permissions'

# func
function calc(){ echo $(( $1)) }

# mysql
export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"

# mise
eval "$(mise activate zsh)"

[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
