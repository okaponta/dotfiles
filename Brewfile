# このMacにbrewで入れるものの正本。
# 追加：ここに1行書いて `brew bundle`
# 削除：行を消して `brew bundle cleanup --force`
# 言語ランタイムとバージョン固定したいツールは mise（mise/config.toml）、Rust は rustup で管理する。

# --- CLI ---
brew "mise"            # 言語ランタイム管理
brew "gh"              # GitHub CLI
brew "gitleaks"        # 秘密情報スキャン
brew "wget"
brew "tree"
brew "watch"
brew "cloc"            # 行数カウント
brew "ffmpeg"
brew "mysql-client"
brew "libpq", link: true   # psql（keg-onlyなのでリンクする）
brew "zsh-completions"

# --- GUI ---
cask "alfred"
cask "claude"
cask "docker-desktop"
cask "intellij-idea-ce"
cask "linearmouse"
cask "postman"
cask "scroll-reverser"
cask "shottr"
